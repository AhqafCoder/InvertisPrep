PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@<host>/<dbname>?retryWrites=true&w=majority

JWT_SECRET=replace-with-random-32-byte-hex
CLIENT_URL=http://localhost:3000

# Rate limiting (per user-or-IP buckets on the HTTP API)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
# Set to 1 when running behind a reverse proxy (nginx/Render) so req.ip
# resolves to the real client instead of the proxy hop.
TRUST_PROXY=0
