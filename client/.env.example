# InvertisPrep client — copy to .env.local and fill in real values.
# NOTE: API_URL / PDF_API_URL are server-only (no NEXT_PUBLIC_ prefix).
# They are used by next.config.ts rewrites so backend URLs never ship in the
# browser bundle. See README "Environment Variables" for details.

# Main API server (Express :5000) — server-only
API_URL=http://localhost:5000

# PDF microservice (Express :5002) — server-only
PDF_API_URL=http://localhost:5002

# NextAuth (Google OAuth handshake only)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-32-byte-hex
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Quizzo realtime server (public; browser connects directly) — optional,
# defaults to http://localhost:5001 when unset
NEXT_PUBLIC_QUIZ_SERVER_URL=
